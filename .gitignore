# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Entornos virtuales
.venv/
venv/

# Datos versionados por DVC, no por git (sección 4.18: manifiesto de datos)
/service-cnn/data/raw/*
!/service-cnn/data/raw/.gitkeep
/service-cnn/data/interim/*
!/service-cnn/data/interim/.gitkeep
/service-cnn/data/processed/*
!/service-cnn/data/processed/.gitkeep

# Artefactos de modelos/reportes generados (regenerables vía dvc repro)
/service-cnn/reports/*
!/service-cnn/reports/.gitkeep

# OS
.DS_Store
Thumbs.db

# Archivos de bloqueo temporales de Microsoft Office
~$*.docx
~$*.xlsx

# Metadata interna de la herramienta de asistencia (no forma parte del proyecto)
.claude/

# Descargas de datos crudos externos, fuera de service-cnn/ (no forman parte
# del código ni deben versionarse en git; ver service-cnn/data/manifest/ para
# el registro de fuente/hash/versión de cada descarga, sección 4.18)
/DATA_PERFIL_PRODUCTIVO_CULTIVO.zip
/DATA_PERFIL_PRODUCTIVO_CULTIVO/
/DATA_PERFIL_PRODUCTIVO.zip
